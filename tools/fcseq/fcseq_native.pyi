"""Native PyO3 interface to the same Score model used by the PLITA GUI."""
class Controller:
    def import_nsf(self, path: str) -> None: ...
    def export_nsf(self, path: str) -> str: ...
    def nsf_info(self) -> str: ...
    def set_nsf_song(self, song: int) -> None: ...
    def set_nsf_seconds(self, seconds: int) -> None: ...
    def __init__(self) -> None: ...
    def load_project(self, path: str) -> None: ...
    def save_project(self, path: str) -> None: ...
    def project_json(self) -> str: ...
    def load_json(self, json: str) -> None: ...
    def validate(self) -> None: ...
    def set_tempo(self, bpm: float) -> None: ...
    def set_name(self, name: str) -> None: ...
    def add_section(self, name: str) -> None: ...
    def set_section_name(self, section: int, name: str) -> None: ...
    def clear_track(self, section: int, channel: int) -> None: ...
    def add_note(self, section: int, channel: int, row: int, length: int, note: int) -> None: ...
    def set_note(self, section: int, channel: int, index: int, row: int, length: int, note: int) -> None: ...
    def delete_note(self, section: int, channel: int, index: int) -> None: ...
    def undo(self) -> bool: ...
    def redo(self) -> bool: ...
    def set_expansion(self, chip: str) -> None: ...
    def set_loop(self, enabled: bool) -> None: ...
    def set_bars(self, section: int, bars: int) -> None: ...
    def duplicate_section(self, section: int) -> None: ...
    def delete_section(self, section: int) -> None: ...
    def set_track_mix(self, section: int, channel: int, mute: bool, solo: bool) -> None: ...
    def set_sound(self, section: int, channel: int, index: int, json: str) -> None: ...
    def edit_notes(self, section: int, selection: list[tuple[int,int]], operation: str, value: int = 0) -> list[tuple[int,int]]: ...
    def import_audio(self, path: str) -> int: ...
    def set_sample_settings(self, index: int, start: int, end: int, gain: float, normalize: bool, reverse: bool, rate: int) -> None: ...
    def export_dpcm(self, index: int, path: str) -> None: ...
    def set_fds_wave(self, values: list[int]) -> None: ...
    def set_n163_wave(self, index: int, values: list[int]) -> None: ...
    def set_n163_channels(self, channels: int) -> None: ...
    def set_vrc7_parameter(self, index: int, value: int) -> None: ...
    def set_vrc7_patch(self, values: list[int]) -> None: ...
    def export_kitaqfc(self, directory: str, header: str = "fcseq_score.h") -> str: ...
    def render_wav(self, path: str, section: int = 0) -> str: ...
